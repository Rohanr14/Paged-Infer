# Keep raw benchmark and validation evidence while collapsing generated reports in
# GitHub's review view. Protocols, analysis scripts, source patches and guides
# remain ordinary reviewable files.
docs/measurements/**/*.jsonl linguist-generated=true
docs/measurements/**/*.time linguist-generated=true
docs/measurements/**/*.stdout linguist-generated=true
docs/measurements/**/*.log linguist-generated=true whitespace=-blank-at-eof
docs/measurements/**/analysis.json linguist-generated=true
docs/measurements/**/analyzer-validation.json linguist-generated=true
