+#[cfg(target_arch = "aarch64")]
+#[test]
+fn test_six_wide_int8_tile_preserves_exact_dot_arithmetic() {
+    for n in [
+        0usize, 1, 3, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 96, 127, 128, 129, 2048, 8192,
+    ] {
+        let weights: Vec<i8> = (0..n)
+            .map(|i| match i % 5 {
+                0 => i8::MIN,
+                1 => i8::MAX,
+                2 => -1,
+                3 => 0,
+                _ => ((i * 31) % 127) as i8,
+            })
+            .collect();
+        let activations: Vec<f32> = (0..6 * n)
+            .map(|i| ((i * 17 % 211) as f32) * 0.011 - 1.2)
+            .collect();
+        let actual = simd::dot_i8_multi::<6>(&weights, &activations, n);
+        for (b, actual) in actual.into_iter().enumerate() {
+            let expected = simd::dot_i8(&weights, &activations[b * n..(b + 1) * n]);
+            assert_eq!(actual.to_bits(), expected.to_bits(), "n={n}, row={b}");
+        }
+    }
+}
--- /dev/null
+++ b/tests/neon_i8_tile_tests.rs
@@ -0,0 +1,89 @@
+#![cfg(target_arch = "aarch64")]
+
+use paged_infer::math::{matmat_i8_weight_parallel, transpose_rb_to_br};
+use paged_infer::simd;
+use std::process::Command;
+
+#[test]
+fn neon_six_wide_matrix_matches_scaled_single_dots() {
+    const CHILD: &str = "PAGED_INFER_TILE6_PARITY_CHILD";
+    if std::env::var_os(CHILD).is_none() {
+        // The tile knob is cached in a OnceLock. Select it before a fresh
+        // process starts, without racing other tests' environment or kernels.
+        let output = Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "neon_six_wide_matrix_matches_scaled_single_dots",
+                "--nocapture",
+            ])
+            .env(CHILD, "1")
+            .env("PAGED_INFER_MATMUL_TILE", "6")
+            .env("RAYON_NUM_THREADS", "4")
+            .output()
+            .expect("launch isolated six-wide matrix test");
+        assert!(
+            output.status.success(),
+            "six-wide matrix child failed:\n{}\n{}",
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr)
+        );
+        return;
+    }
+    assert_eq!(std::env::var("PAGED_INFER_MATMUL_TILE").unwrap(), "6");
+
+    let scales = [0.00390625, 0.03125, 0.17, 1.0, 0.0001];
+    let rows = scales.len();
+    for cols in [
+        0usize, 1, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 2048, 8192,
+    ] {
+        let weights: Vec<i8> = (0..rows * cols)
+            .map(|i| match i % 5 {
+                0 => i8::MIN,
+                1 => i8::MAX,
+                2 => -1,
+                3 => 0,
+                _ => ((i * 31) % 127) as i8,
+            })
+            .collect();
+        // Include full six-wide tiles, every 4/2/1 remainder, and batch32's
+        // five six-wide tiles followed by a two-wide tile.
+        for batch in [6, 7, 10, 31, 32, 33] {
+            let activations: Vec<f32> = (0..batch * cols)
+                .map(|i| ((i * 37 % 251) as f32) * 0.013 - 1.6)
+                .collect();
+            let sentinel = 123.25_f32;
+            let mut actual_rb = vec![sentinel; rows * batch + 2];
+            matmat_i8_weight_parallel(
+                &mut actual_rb[1..1 + rows * batch],
+                &activations,
+                &weights,
+                &scales,
+                batch,
+                rows,
+                cols,
+            );
+            assert_eq!(actual_rb[0].to_bits(), sentinel.to_bits());
+            assert_eq!(actual_rb[1 + rows * batch].to_bits(), sentinel.to_bits());
+            let mut actual_br = vec![f32::NAN; batch * rows];
+            transpose_rb_to_br(&actual_rb[1..1 + rows * batch], &mut actual_br, rows, batch);
+            for (r, &scale) in scales.iter().enumerate() {
+                for b in 0..batch {
+                    let expected = simd::dot_i8(
+                        &weights[r * cols..(r + 1) * cols],
+                        &activations[b * cols..(b + 1) * cols],
+                    ) * scale;
+                    assert_eq!(
+                        actual_rb[1 + r * batch + b].to_bits(),
+                        expected.to_bits(),
+                        "row-major: cols={cols}, batch={batch}, row={r}, token={b}"
+                    );
+                    assert_eq!(
+                        actual_br[b * rows + r].to_bits(),
+                        expected.to_bits(),
+                        "batch-major: cols={cols}, batch={batch}, row={r}, token={b}"
+                    );
+                }
+            }
+        }
+    }
+}
